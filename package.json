{
  "name": "job-auto-apply",
  "version": "1.0.0",
  "description": "Full-stack job application automation system using Puppeteer Stealth and React Tailwind Dashboard",
  "main": "server/server.js",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"node server/server.js\" \"npm --prefix client run dev\"",
    "build:client": "npm --prefix client run build",
    "save-cookies:indeed": "node server/cookie-helper.js indeed",
    "save-cookies:naukri": "node server/cookie-helper.js naukri",
    "check-inbox": "node -e \"require('./server/auto-responder').runAutoReplyScan()\"",
    "login:whatsapp": "node -e \"require('./server/whatsapp-outreach').openWhatsAppLogin()\"",
    "dispatch:whatsapp": "node -e \"require('./server/whatsapp-outreach').startBatchAutoSend()\""
  },
  "keywords": [
    "puppeteer",
    "stealth",
    "job-automation",
    "indeed",
    "naukri",
    "react",
    "tailwind"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "puppeteer": "^25.17.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
