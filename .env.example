# Job Auto-Apply Configuration

# Server Port
PORT=5000

# Browser Configuration
HEADLESS=false
BROWSER_TIMEOUT=60000

# Human-like delay range between job applications (in milliseconds)
MIN_DELAY_MS=5000
MAX_DELAY_MS=15000

# Default Resume Path (Absolute path on your local Windows PC)
# Example: C:\Users\Asus\Desktop\job-auto-apply\assets\my_resume.pdf
DEFAULT_RESUME_PATH=assets/resume.pdf

# Automation Target Platform: indeed | naukri | both
DEFAULT_PLATFORM=both

# Max applications per run
MAX_APPLICATIONS=25

# Optional direct credentials (Prefer using cookies.json via cookie-helper for safer login)
INDEED_EMAIL=
INDEED_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

